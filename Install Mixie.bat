@echo off
chcp 65001 >nul
title Mixie - install / update
rem Mixie - made by Modda-ctrl - https://github.com/Modda-ctrl/Mixie
cd /d "%~dp0"

rem --- Find Python
set PY=
where py >nul 2>nul && set PY=py
if not defined PY (
    where python >nul 2>nul && set PY=python
)
if not defined PY (
    echo Python was not found.
    echo Install Python from https://www.python.org/downloads/
    echo and tick "Add python.exe to PATH" during the installation.
    pause
    exit /b 1
)

rem --- Run the installer (the code is embedded further down in this file)
%PY% -X utf8 -c "import sys,base64;d=open(sys.argv[1],'rb').read();a,b=b'::'+b'INSTALLER::',b'::'+b'INSTALLEREND::';exec(compile(base64.b64decode(b''.join(d.split(a,1)[1].split(b,1)[0].split())),'installer','exec'))" "%~f0"
echo.
pause
exit /b

